diff --git a/api-test/src/main/java/io/inji/testrig/apirig/injicertify/testscripts/OpenIDConformanceTest.java b/api-test/src/main/java/io/inji/testrig/apirig/injicertify/testscripts/OpenIDConformanceTest.java
